        <mxCell id="p3-result-lane" value="스킬 결과가 공정 복구 정책을 촉발하는 흐름" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FC;strokeColor=#CBD1DC;fontColor=#161B2A;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
