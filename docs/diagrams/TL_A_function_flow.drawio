  <diagram id="safety-flow" name="3 안전·예외 흐름">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3-title" value="A 스킬 안전·예외 흐름 — SafePose, 인터락, NUDGE, 결과 기반 복구" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#161B2A;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-subtitle" value="안전은 skill_node + 두산 컨트롤러만으로 성립해야 함 · 공정/HMI가 중단돼도 정지 또는 안전 자세가 가능해야 함" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#5F6980;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="2120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-trigger" value="안전 자세 요청 발생&lt;br&gt;&lt;br&gt;HMI Interlock ENTER&lt;br&gt;공정 ERROR·취소&lt;br&gt;운영자 SafePose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6980;fontColor=#161B2A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p3-srv" value="skill_node._srv_safe&lt;br&gt;&lt;br&gt;1. 대기 Job 전부 cancelled&lt;br&gt;2. 현재 Job.cancel=true&lt;br&gt;3. safe Job을 큐에 등록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9FB;strokeColor=#3451D1;fontColor=#161B2A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="130" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p3-block" value="현재 블로킹&lt;br&gt;movel 실행 중인가?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FBEBDD;strokeColor=#D9782A;fontColor=#161B2A;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="870" y="140" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-step" value="아니오 — 단계 경계&lt;br&gt;&lt;br&gt;cancel 확인&lt;br&gt;compliance_off()&lt;br&gt;safe 좌표로 이동" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2E7D32;fontColor=#161B2A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1210" y="110" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3-blocking" value="예 — 현재 제한(I-004)&lt;br&gt;&lt;br&gt;cancel 플래그는 즉시 반영되지 않음&lt;br&gt;두산 PFL·충돌 감지가 물리 안전 담당&lt;br&gt;movel 반환 뒤 safe Job 실행&lt;br&gt;&lt;br&gt;개선 후보: amovel + check_motion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#161B2A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1210" y="300" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p3-safe" value="안전 자세 도달&lt;br&gt;&lt;br&gt;SAFE_POSE 이벤트&lt;br&gt;Service success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2E7D32;fontColor=#161B2A;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1630" y="160" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-enter" value="process가 granted=true&lt;br&gt;&lt;br&gt;사람 투입·보충·수습&lt;br&gt;HMI EXIT 후 이전 공정 재개" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFF3;strokeColor=#1F7A8C;fontColor=#161B2A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
