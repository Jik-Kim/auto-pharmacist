        <mxCell id="c4" value="process_node (C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3451D1;fontColor=#161B2A;fontSize=14;align=center;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="700" height="560" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="rclpy 콜백 스레드&lt;br&gt;&lt;br&gt;_srv_submit → FSM 생성, run_loop 시작&lt;br&gt;_srv_qa → _qa_decision 저장, _qa.set()&lt;br&gt;_srv_interlock → ENTER: cancel→safe_pose→granted&lt;br&gt;                        EXIT: _interlock_exit.set()&lt;br&gt;event(NUDGE) 구독 → 게이트 토글&lt;br&gt;   (NUDGE_WAIT 중엔 토글이 아니라 다음 세트 신호)&lt;br&gt;&lt;br&gt;콜백은 값만 저장한다. 로봇을 부르지 않는다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9FB;strokeColor=#3451D1;fontColor=#161B2A;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="150" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="run_loop 스레드 (배치마다 1개)&lt;br&gt;&lt;br&gt;req = fsm.start()&lt;br&gt;while req:&lt;br&gt;    res = _execute(req)   ← 스킬 한 번에 하나&lt;br&gt;    req = fsm.on_result(req, res)&lt;br&gt;    발행(state·weight·scoop_cycle·result·deviation·event)&lt;br&gt;&lt;br&gt;wait_qa / wait_interlock 는 Event.wait()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9FB;strokeColor=#3451D1;fontColor=#161B2A;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="930" y="150" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="core/process_fsm.py — ProcessFSM (ROS 비의존, pytest)&lt;br&gt;&lt;br&gt;state · mode · idx(원료) · tare_g · verify_net_g · cur(ItemRun: attempts(붓기)·returns(반환)·invalid·scoop_tare·scooped·residual·actual·verdict) · results · deviations · _counts · _resume · _qa_step · slot&lt;br&gt;&lt;br&gt;start() → 첫 요청     on_result(req, res) → 다음 요청 dict 또는 None(끝)&lt;br&gt;_deviate(kind, step) → deviation.py policy(kind, count) → RETRY / REFILL / QA / FORCED&lt;br&gt;_carry(src, dst) → {&quot;kind&quot;:&quot;carry&quot;, src, dst, slot}&lt;br&gt;&lt;br&gt;의존: gmp_dosing.core.dosing.decide(target, net, tol, attempts, valid, invalid, cfg) → DONE / SCOOP(fraction) / DEVIATION(kind)&lt;br&gt;        core/recipe.py parse() → RecipeSpec(product, items[Item(material_id, target_g, tol_pct)])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFF3;strokeColor=#1F7A8C;fontColor=#161B2A;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="390" width="640" height="240" as="geometry" />
        </mxCell>
