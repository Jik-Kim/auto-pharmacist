        <mxCell id="c2" value="gmp_process — process_node 입출력 (계약 v1.2 초안 · ns /cell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#161B2A;fontSize=18;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1">
