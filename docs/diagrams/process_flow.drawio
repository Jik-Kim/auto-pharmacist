<mxfile host="app.diagrams.net" type="device"><diagram id="1 노드 입출력" name="1 노드 입출력"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="gmp_process — process_node 입출력 (계약 v1.1 · ns /cell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#161B2A;fontSize=18;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="40" as="geometry"/></mxCell><mxCell id="c3" value="hmi_web_node (D)&lt;br&gt;&lt;br&gt;웹 HMI · Flask :5000&lt;br&gt;&lt;br&gt;주문 제출&lt;br&gt;QA 승인 / 폐기&lt;br&gt;인터락 ENTER / EXIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5FA;strokeColor=#5F6980;fontColor=#161B2A;fontSize=12;align=center;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="220" height="420" as="geometry"/></mxCell><mxCell id="c4" value="process_node (C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3451D1;fontColor=#161B2A;fontSize=14;align=center;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="700" height="560" as="geometry"/></mxCell><mxCell id="c5" value="rclpy 콜백 스레드&lt;br&gt;&lt;br&gt;_srv_submit → FSM 생성, run_loop 시작&lt;br&gt;_srv_qa → _qa_decision 저장, _qa.set()&lt;br&gt;_srv_interlock → ENTER: cancel→safe_pose→granted&lt;br&gt;                        EXIT: _interlock_exit.set()&lt;br&gt;event(NUDGE) 구독 → 게이트 토글&lt;br&gt;&lt;br&gt;콜백은 값만 저장한다. 로봇을 부르지 않는다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9FB;strokeColor=#3451D1;fontColor=#161B2A;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="450" y="150" width="300" height="200" as="geometry"/></mxCell><mxCell id="c6" value="run_loop 스레드 (배치마다 1개)&lt;br&gt;&lt;br&gt;req = fsm.start()&lt;br&gt;while req:&lt;br&gt;    res = _execute(req)   ← 스킬 한 번에 하나&lt;br&gt;    req = fsm.on_result(req, res)&lt;br&gt;    발행(state·weight·result·deviation·event)&lt;br&gt;&lt;br&gt;wait_qa / wait_interlock 는 Event.wait()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9FB;strokeColor=#3451D1;fontColor=#161B2A;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="790" y="150" width="300" height="200" as="geometry"/></mxCell><mxCell id="c7" value="core/process_fsm.py — ProcessFSM (ROS 비의존, pytest)&lt;br&gt;&lt;br&gt;state · mode · idx(원료) · tare_g · cur(ItemRun: attempts·invalid·actual·verdict) · results · deviations · _counts · _resume · slot&lt;br&gt;&lt;br&gt;start() → 첫 요청     on_result(req, res) → 다음 요청 dict 또는 None(끝)&lt;br&gt;_deviate(kind, step) → deviation.py policy(kind, count) → RETRY / REFILL / QA / FORCED&lt;br&gt;_carry(src, dst) → {&quot;kind&quot;:&quot;carry&quot;, src, dst, slot}&lt;br&gt;&lt;br&gt;의존: gmp_dosing.core.dosing.decide(target, net, tol, attempts, valid, invalid, cfg) → DONE / SCOOP(fraction) / DEVIATION(kind)&lt;br&gt;        core/recipe.py parse() → RecipeSpec(product, items[Item(material_id, target_g, tol_pct, grade, scoop_id)])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFF3;strokeColor=#1F7A8C;fontColor=#161B2A;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="450" y="390" width="640" height="240" as="geometry"/></mxCell><mxCell id="c8" value="Event / 플래그" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F6980;strokeWidth=1.5;fontColor=#5F6980;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="dict 요청 ↔ dict 결과" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F7A8C;strokeWidth=1.5;fontColor=#1F7A8C;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="skill_node (A)&lt;br&gt;&lt;br&gt;로봇을 만지는 유일한 노드&lt;br&gt;DSR 워커 스레드 1개 — 직렬&lt;br&gt;&lt;br&gt;Action 서버 4&lt;br&gt;  move_to_station · scoop · pour · weigh_container&lt;br&gt;Service 서버 3&lt;br&gt;  grip · measure_force · safe_pose&lt;br&gt;&lt;br&gt;발행: gripper_state · event(NUDGE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5FA;strokeColor=#5F6980;fontColor=#161B2A;fontSize=12;align=center;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="100" width="320" height="560" as="geometry"/></mxCell><mxCell id="c11" value="record_node (D) — SQLite 단일 기록자        hmi_web_node (D) — 화면 표시&lt;br&gt;&lt;br&gt;구독: state · weight · dispense_result · deviation · event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5FA;strokeColor=#5F6980;fontColor=#161B2A;fontSize=12;align=center;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="720" width="700" height="110" as="geometry"/></mxCell><mxCell id="c12" value="Service  submit_order (SubmitOrder: Recipe → accepted, batch_id)&lt;br&gt;실행 중이면 accepted=false" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3451D1;strokeWidth=1.5;fontColor=#3451D1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Service  qa_decision (batch_id, deviation_id, decision, operator_id → accepted)&lt;br&gt;DEVIATION 아니면 거부" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3451D1;strokeWidth=1.5;fontColor=#3451D1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="Service  interlock (ENTER=1 / EXIT=2, reason → granted)&lt;br&gt;ENTER 는 safe_pose 성공 후 granted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3451D1;strokeWidth=1.5;fontColor=#3451D1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.48;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="Action  run_batch (RunBatch) — CLI·시험용, 우선순위 낮음" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F6980;strokeWidth=1.5;fontColor=#5F6980;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.92;exitDx=0;exitDy=0;entryX=0;entryY=0.66;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="Action  move_to_station (station_id, approach ABOVE/AT, vel_scale → success, reached)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D9782A;strokeWidth=1.5;fontColor=#D9782A;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="Action  scoop (material_id, attempt → success, contact_detected)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D9782A;strokeWidth=1.5;fontColor=#D9782A;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.22;exitDx=0;exitDy=0;entryX=0;entryY=0.22;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="Action  pour (target_station, fraction → success)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D9782A;strokeWidth=1.5;fontColor=#D9782A;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.34;exitDx=0;exitDy=0;entryX=0;entryY=0.34;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Action  weigh_container (container_station, tare_g → reading: gross/net/std/valid)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D9782A;strokeWidth=1.5;fontColor=#D9782A;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.46;exitDx=0;exitDy=0;entryX=0;entryY=0.46;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="Service  grip (close, width_mm, force_n, timeout_s → success, final_width_mm, grip_inferred)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D9782A;strokeWidth=1.5;fontColor=#D9782A;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.58;exitDx=0;exitDy=0;entryX=0;entryY=0.58;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="Service  measure_force (samples, settle_s → fz_mean_n, fz_std_n, valid)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D9782A;strokeWidth=1.5;fontColor=#D9782A;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" a