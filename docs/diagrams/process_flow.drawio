              <mxPoint x="628.5" y="230" />
              <mxPoint x="15" y="230" />
              <mxPoint x="15" y="930" />
              <mxPoint x="97" y="930" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c52" edge="1" parent="1" source="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C0392B;strokeWidth=1.5;fontColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" target="c17" value="GRIP_FAIL 4회 (FORCED)">
          <mxGeometry relative="1" x="0.3" y="-40" as="geometry">
            <Array as="points">
              <mxPoint x="68.5" y="900" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c53" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C0392B;strokeWidth=1.5;fontColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" target="c17" value="measure invalid (TODO)">
          <mxGeometry relative="1" x="0.5" y="-14" as="geometry">
            <Array as="points">
              <mxPoint x="173" y="165" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c54" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6980;fontColor=#5F6980;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" value="루프 게이트 (FSM 밖, D-21 추가 7)&lt;br&gt;&lt;br&gt;skill_node 가 event NUDGE 를 쏘면 run_loop 가 다음 요청 전에 멈추고&lt;br&gt;state.mode = PAUSED(note=&quot;NUDGE&quot;) 발행, 두 번째 NUDGE 로 재개.&lt;br&gt;인터락 중·계량 대기 중에만 감지된다 (블로킹 movel 중은 두산 충돌 감지 담당)" vertex="1">
          <mxGeometry height="150" width="380" x="1440" y="120" as="geometry" />
        </mxCell>
        <mxCell id="c55" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6980;fontColor=#5F6980;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" value="일탈 정책 (deviation.py)&lt;br&gt;&lt;br&gt;GRIP_FAIL  3회 RETRY → FORCED&lt;br&gt;SCOOP_EMPTY  3회 RETRY → REFILL&lt;br&gt;MATERIAL_EMPTY  즉시 REFILL&lt;br&gt;OVERFILL / TIMEOUT  즉시 QA&lt;br&gt;WEIGH_INVALID  2회 RETRY → QA&lt;br&gt;VERIFY_MISMATCH [v1.2]  즉시 QA&lt;br&gt;SLIP 2 · SAFETY_SWITCH 1 · FORCE_LIMIT 1 → FORCED&lt;br&gt;WRONG_TOOL [v1.2]  즉시 QA&lt;br&gt;&lt;br&gt;count = 같은 배치·같은 스텝·같은 kind" vertex="1">
          <mxGeometry height="270" width="240" x="1660" y="880" as="geometry" />
        </mxCell>
        <mxCell id="c56" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6980;fontColor=#5F6980;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" value="D-22 원료 1종 = 6단계: 빈 스쿱 계량 → 퍼올림 → 붓기 전 계량(퍼낸 양 → 붓기 비율, 초과 예방) → 붓기 → 붓기 후 계량(잔량 → 투입량 누적 → 판정) → 반납. 로봇이 저울이라 스쿱을 든 채 재는 것이 가장 싸고, 용기 계량(들어 올림)은 그리퍼가 비어야 해서 배치 끝 VERIFY 한 번.&lt;br&gt;범례   파랑 = 정상 경로   주황 = 일탈·재시도   청록 = 복구·완료   빨강 = 강제 개입·폐기(종료)   회색 = 대기·재계량&lt;br&gt;전이표 밖 조합은 on_result 가 RuntimeError(&quot;전이 없음&quot;) 를 던진다 — 새 상태·kind 를 넣으면 전이와 테스트(test_process_fsm.py)를 같이 넣는다" vertex="1">
          <mxGeometry height="90" width="1860" x="40" y="1180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
