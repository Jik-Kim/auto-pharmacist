        <mxCell id="c3" value="hmi_web_node (D)&lt;br&gt;&lt;br&gt;웹 HMI · Flask :5000&lt;br&gt;&lt;br&gt;주문 제출&lt;br&gt;QA 승인 / 폐기&lt;br&gt;인터락 ENTER / EXIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5FA;strokeColor=#5F6980;fontColor=#161B2A;fontSize=12;align=center;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1">
