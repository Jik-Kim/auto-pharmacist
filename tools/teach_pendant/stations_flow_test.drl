# stations.yaml 위치 시험용 DRL (M0609 / BASE 좌표)
#
# 목적: 자동 공정을 실행하지 않고, stations.yaml의 접근점만 한 점씩 확인한다.
# 사용 전제:
#   1. 컨트롤러에서 tool_weight와 GripperDA_v1 TCP가 이미 선택되어 있어야 한다.
#   2. 로봇을 수동으로 간섭 없는 자세에 둔 뒤, 저속·수동 모드에서 실행한다.
#   3. TEST_STEP 하나만 선택한다. 0은 이동하지 않는다.
#   4. 모든 점을 확인하기 전에는 작업점(AT), 그리퍼 동작, 원료·용기 파지를 실행하지 않는다.
#
# 주의: safe.posx는 자리표시자라 이 파일에서 사용하지 않는다.
#       return_start/end_posx는 아직 미티칭(null)이라 포함하지 않는다.
#       nudge_wait는 관절 경로 검증이 필요한 점이라 이 파일에서 단독 이동하지 않는다.

from DRCF import *

VEL = 10
ACC = 20

# 0: 정지, 아래 번호 중 하나만 선택해 실행
TEST_STEP = 0

# 접근점(AT의 BASE +Z). stations.yaml의 station별 approach_mm를 적용했다.
P_PASSBOX_EMPTY_ABOVE = posx(717.41, -70.37, 150.00, 180.00, -90.00, -90.00)
P_WORKBENCH_ABOVE = posx(423.00, 93.00, 200.00, 90.00, -90.00, -90.00)
P_MATERIAL_1_ABOVE = posx(400.00, -298.00, 260.00, 90.00, -180.00, -90.00)
P_SCOOP_1_ABOVE = posx(400.00, -298.00, 110.00, 90.00, -180.00, -90.00)
P_MATERIAL_2_ABOVE = posx(495.00, -298.00, 260.00, 90.00, -180.00, -90.00)
P_SCOOP_2_ABOVE = posx(495.00, -298.00, 110.00, 90.00, -180.00, -90.00)
P_MATERIAL_3_ABOVE = posx(593.00, -298.00, 260.00, 90.00, -180.00, -90.00)
P_SCOOP_3_ABOVE = posx(593.00, -298.00, 110.00, 90.00, -180.00, -90.00)
P_POUR_START = posx(420.02, 220.00, 233.15, 90.00, 180.00, -90.00)
P_POUR_END = posx(420.00, 160.00, 315.00, 90.00, 130.00, -90.00)
P_PASSBOX_DONE_ABOVE = posx(716.64, 71.32, 150.00, 180.00, -90.00, -90.00)
P_REJECT_BIN_ABOVE = posx(717.41, -220.00, 150.00, 180.00, -90.00, -90.00)


def move_to_test_pose(target):
    # 절대 BASE 좌표 직선 이동. 이동 전 경로 전체의 간섭을 눈으로 확인한다.
    movel(target, vel=VEL, acc=ACC, ref=DR_BASE, mod=DR_MV_MOD_ABS)


def main():
    # 공정 순서에 맞춘 접근점 시험이다. 파지·놓기·그리퍼 명령은 없다.
    if TEST_STEP == 1:
        move_to_test_pose(P_PASSBOX_EMPTY_ABOVE)  # 빈 약통 칸 상부
    elif TEST_STEP == 2:
        move_to_test_pose(P_WORKBENCH_ABOVE)      # 작업대/용기 위치 상부
    elif TEST_STEP == 3:
        move_to_test_pose(P_MATERIAL_1_ABOVE)     # 원료 A 상부
    elif TEST_STEP == 4:
        move_to_test_pose(P_SCOOP_1_ABOVE)        # A 전용 스쿱 상부
    elif TEST_STEP == 5:
        move_to_test_pose(P_MATERIAL_2_ABOVE)     # 원료 B 상부
    elif TEST_STEP == 6:
        move_to_test_pose(P_SCOOP_2_ABOVE)        # B 전용 스쿱 상부
    elif TEST_STEP == 7:
        move_to_test_pose(P_MATERIAL_3_ABOVE)     # 원료 C 상부
    elif TEST_STEP == 8:
        move_to_test_pose(P_SCOOP_3_ABOVE)        # C 전용 스쿱 상부
    elif TEST_STEP == 9:
        move_to_test_pose(P_POUR_START)           # 붓기 시작 자세
    elif TEST_STEP == 10:
        move_to_test_pose(P_POUR_END)             # 붓기 종료 자세
    elif TEST_STEP == 11:
        move_to_test_pose(P_PASSBOX_DONE_ABOVE)   # 완성품 칸 상부
    elif TEST_STEP == 12:
        move_to_test_pose(P_REJECT_BIN_ABOVE)     # 폐기함 상부
    # TEST_STEP == 0 또는 범위 밖 값은 의도적으로 이동하지 않는다.


main()
