# process → skill_node. 로봇 정지 상태에서만 유효. 그램 환산은 하지 않는다 (dosing 이 한다)
uint16 samples          # 0 이면 scale.samples 파라미터
float32 settle_s        # 0 이면 scale.settle_s
---
float32[6] force        # tool 외력 wrench 평균 [Fx,Fy,Fz,Mx,My,Mz], DR_BASE 표현, [N,N,N,N·m,N·m,N·m]
float32 fz_mean_n       # 위 wrench의 Fz 평균 [N]
float32 fz_std_n        # 표본별 Fz 표준편차 [N]
bool valid
string message
