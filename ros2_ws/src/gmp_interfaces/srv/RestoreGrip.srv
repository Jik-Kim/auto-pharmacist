# process → skill. 안전 자세 완료 후 센서·중단 전 이력으로 파지 상태만 복구한다.
# 로봇 이동·그리퍼 개폐·안전 정지 해제는 하지 않는다.
string expected_payload     # empty | cup | scoop. 빈 문자열은 A의 저장 이력으로 확인
string expected_material_id # scoop 기대 시 필수. 그 외 빈 문자열
---
bool success
string payload          # empty | cup | scoop, 실패 시 unknown
string material_id      # scoop일 때만 유효
bool scoop_extracted    # 성공한 scoop 복구에서만 true. 센서가 아닌 중단 전 인출 이력 확인
string message
